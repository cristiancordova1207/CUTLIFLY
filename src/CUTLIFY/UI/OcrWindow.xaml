<Window x:Class="Cutlify.UI.OcrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Texto extraído — CUTLIFY" Width="560" Height="460" MinWidth="380" MinHeight="260"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource Text}"
        Icon="pack://application:,,,/CUTLIFY;component/Assets/cutlify.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="&#xE8D2;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}"/>
            <TextBlock Text="Texto extraído" Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
            <TextBlock Text="  ·  OCR local de Windows" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBox Grid.Row="1" x:Name="TextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" AutomationProperties.Name="Texto reconocido"/>
        <TextBlock Grid.Row="1" x:Name="EmptyText" Text="No se encontró texto en la imagen." Style="{StaticResource Secondary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CopySelection" Content="Copiar selección" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/>
            <Button x:Name="CopyAll" Content="Copiar todo" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button x:Name="CloseButton" Content="Cerrar" Style="{StaticResource OutlineButton}"/>
        </StackPanel>
    </Grid>
</Window>
