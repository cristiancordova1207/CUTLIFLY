<Window x:Class="Cutlify.UI.AudioRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grabadora de audio — CUTLIFY" Width="640" Height="560" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowGradient}"
        FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BaseFontSize}" Foreground="{DynamicResource Text}"
        Icon="pack://application:,,,/CUTLIFY;component/Assets/cutlify.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="16,0,6,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE720;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}"/>
                <TextBlock Text="Grabadora de audio" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Secondary}" Margin="10,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,0,0">
                <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimizar"/>
                <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Cerrar (la grabación continúa)"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,0,16,12" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="2,0,0,10">
                    <TextBlock Text="Pistas" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  cada pista se guarda por separado y además se crea una mezcla" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="TrackList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusM}" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="{DynamicResource RadiusS}" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" BorderThickness="0" Background="Transparent"
                                                         FontWeight="SemiBold" AutomationProperties.Name="Nombre de la pista" IsEnabled="{Binding Editable}"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" Margin="4,0,0,4" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Value="{Binding Level, Mode=OneWay}" Maximum="1" Height="6" Margin="4,0,0,0"
                                                             Foreground="{DynamicResource Accent}" Background="{DynamicResource AccentSoft}" BorderThickness="0"
                                                             AutomationProperties.Name="Nivel"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                                                <Slider Width="90" Minimum="0" Maximum="2" Value="{Binding Gain}" VerticalAlignment="Center"
                                                        ToolTip="Volumen en la mezcla" AutomationProperties.Name="Volumen en la mezcla"/>
                                                <ToggleButton IsChecked="{Binding Muted}" Style="{StaticResource SegmentToggle}" Padding="8,5" Margin="8,0,0,0"
                                                              ToolTip="Excluir de la mezcla (la pista se guarda igualmente)" AutomationProperties.Name="Silenciar en la mezcla">
                                                    <TextBlock Text="&#xE74F;" Style="{StaticResource Icon}" FontSize="13"/>
                                                </ToggleButton>
                                                <Button Style="{StaticResource FlatButton}" Padding="8,5" Margin="4,0,0,0" Click="RemoveTrack_Click"
                                                        ToolTip="Quitar pista" AutomationProperties.Name="Quitar pista" IsEnabled="{Binding Editable}">
                                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyTracks" Text="Añade al menos una pista." Style="{StaticResource Secondary}" Margin="4,6"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" x:Name="AddPanel" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AddMic" Style="{StaticResource SoftButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" Style="{StaticResource Icon}" FontSize="13"/><TextBlock Text="+ Micrófono" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="AddSystem" Style="{StaticResource SoftButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="13"/><TextBlock Text="+ Escritorio" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="AddApp" Style="{StaticResource SoftButton}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="13"/><TextBlock Text="+ Aplicación" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="16,0,16,16" Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="RecordButton" Width="52" Height="52" Cursor="Hand" ToolTip="Grabar" AutomationProperties.Name="Grabar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="26" Background="#F0506E">
                                    <Border x:Name="inner" Width="18" Height="18" CornerRadius="{DynamicResource RadiusS}" Background="White"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.9"/></Trigger>
                                    <Trigger Property="Tag" Value="recording">
                                        <Setter TargetName="inner" Property="CornerRadius" Value="3"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="PauseButton" Style="{StaticResource OutlineButton}" Margin="10,0,0,0" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PauseIcon" Text="&#xE769;" Style="{StaticResource Icon}" FontSize="13"/>
                            <TextBlock x:Name="PauseLabel" Text="Pausar" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TimeText" Text="00:00:00" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StateText" Text="Listo para grabar" Style="{StaticResource Secondary}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Mezcla" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="FormatCombo" MinWidth="110" AutomationProperties.Name="Formato de la mezcla">
                            <ComboBoxItem Tag="M4A">M4A (AAC)</ComboBoxItem>
                            <ComboBoxItem Tag="MP3">MP3</ComboBoxItem>
                            <ComboBoxItem Tag="WAV">WAV</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="SeparateSwitch" Style="{StaticResource Switch}" Content="Guardar cada pista en WAV" Margin="0,8,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
