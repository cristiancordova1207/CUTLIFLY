<Window x:Class="Cutlify.UI.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CUTLIFY" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Width="180" Height="180" WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}">
    <Border CornerRadius="90" Background="#E61F1B2E" BorderBrush="#7C5CFF" BorderThickness="3">
        <Grid>
            <TextBlock x:Name="Number" Text="3" FontSize="84" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-10,0,0"/>
            <TextBlock x:Name="Caption" Text="Captura" FontSize="13" Foreground="#C9C2E8"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"/>
        </Grid>
    </Border>
</Window>
