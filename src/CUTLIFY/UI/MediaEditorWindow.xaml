<Window x:Class="Cutlify.UI.MediaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Editor — CUTLIFY" Width="1240" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}"
        FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BaseFontSize}" Foreground="{DynamicResource Text}"
        Icon="pack://application:,,,/CUTLIFY;component/Assets/cutlify.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="16,0,6,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TitleIcon" Text="&#xE720;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}"/>
                <TextBlock x:Name="TitleText" Text="Editor" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Secondary}" Margin="10,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,0,0">
                <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimizar"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximizar"/>
                <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Cerrar"/>
            </StackPanel>
        </Grid>

        <wv2:WebView2 x:Name="Web" Grid.Row="1" DefaultBackgroundColor="Transparent"/>
        <TextBlock x:Name="ErrorText" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Secondary}" FontSize="14"/>
    </Grid>
</Window>
