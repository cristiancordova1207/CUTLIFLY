<UserControl x:Class="Cutlify.Editor.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Herramientas -->
        <Border Style="{StaticResource Card}" Padding="8,6" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <RadioButton x:Name="ToolSelect" GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Select" ToolTip="Cursor (mover)">
                        <StackPanel><TextBlock Text="&#xE7C9;" Style="{StaticResource Icon}"/><TextBlock Text="Cursor" Style="{StaticResource Caption}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolPen" GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Pen" ToolTip="Lápiz">
                        <StackPanel><TextBlock Text="&#xEDC6;" Style="{StaticResource Icon}"/><TextBlock Text="Lápiz" Style="{StaticResource Caption}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolHighlighter" GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Highlighter" ToolTip="Resaltador">
                        <StackPanel><TextBlock Text="&#xE7E6;" Style="{StaticResource Icon}"/><TextBlock Text="Resaltador" Style="{StaticResource Caption}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolEraser" GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Eraser" ToolTip="Borrador">
                        <StackPanel><TextBlock Text="&#xE75C;" Style="{StaticResource Icon}"/><TextBlock Text="Borrador" Style="{StaticResource Caption}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolShape" GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Shape" ToolTip="Formas">
                        <StackPanel><TextBlock Text="&#xF158;" Style="{StaticResource Icon}"/><TextBlock Text="Formas" Style="{StaticResource Caption}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolText" GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Text" ToolTip="Texto">
                        <StackPanel><TextBlock Text="&#xE8D2;" Style="{StaticResource Icon}"/><TextBlock Text="Texto" Style="{StaticResource Caption}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolCrop" GroupName="tools" Style="{StaticResource ToolToggle}" Tag="Crop" ToolTip="Recortar">
                        <StackPanel><TextBlock Text="&#xE7A8;" Style="{StaticResource Icon}"/><TextBlock Text="Recortar" Style="{StaticResource Caption}"/></StackPanel>
                    </RadioButton>
                    <Border Width="1" Margin="8,6" Background="{DynamicResource BorderBrush}"/>
                    <Button x:Name="UndoButton" Style="{StaticResource FlatButton}" ToolTip="Deshacer (Ctrl+Z)" IsEnabled="False">
                        <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}"/>
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource FlatButton}" ToolTip="Rehacer (Ctrl+Y)" IsEnabled="False">
                        <TextBlock Text="&#xE7A6;" Style="{StaticResource Icon}"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="CopyButton" Style="{StaticResource FlatButton}" ToolTip="Copiar (Ctrl+C)" MinWidth="56">
                        <StackPanel><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/><TextBlock Text="Copiar" Style="{StaticResource Caption}"/></StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource FlatButton}" ToolTip="Guardar (Ctrl+S)" MinWidth="56">
                        <StackPanel><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}"/><TextBlock Text="Guardar" Style="{StaticResource Caption}"/></StackPanel>
                    </Button>
                    <Button x:Name="SaveAsButton" Style="{StaticResource FlatButton}" ToolTip="Guardar como / exportar (formato y ubicación)" MinWidth="56">
                        <StackPanel><TextBlock Text="&#xE792;" Style="{StaticResource Icon}"/><TextBlock Text="Guardar como" Style="{StaticResource Caption}"/></StackPanel>
                    </Button>
                    <Button x:Name="OcrButton" Style="{StaticResource FlatButton}" ToolTip="Extraer texto (OCR local)" MinWidth="56">
                        <StackPanel><TextBlock Text="&#xE8D2;" Style="{StaticResource Icon}"/><TextBlock Text="Extraer texto" Style="{StaticResource Caption}"/></StackPanel>
                    </Button>
                    <Button x:Name="PinButton" Style="{StaticResource FlatButton}" ToolTip="Fijar encima de todo" MinWidth="56">
                        <StackPanel><TextBlock Text="&#xE718;" Style="{StaticResource Icon}"/><TextBlock Text="Fijar" Style="{StaticResource Caption}"/></StackPanel>
                    </Button>
                    <Button x:Name="FolderButton" Style="{StaticResource FlatButton}" ToolTip="Abrir ubicación" MinWidth="56">
                        <StackPanel><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}"/><TextBlock Text="Ubicación" Style="{StaticResource Caption}"/></StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource FlatButton}" ToolTip="Eliminar" MinWidth="56">
                        <StackPanel><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/><TextBlock Text="Eliminar" Style="{StaticResource Caption}"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Opciones contextuales -->
        <Border Grid.Row="1" x:Name="OptionsBar" Margin="0,0,0,8" Padding="10,6" CornerRadius="12"
                Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="ColorArea" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <StackPanel x:Name="RecentPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <Button x:Name="MoreColorsButton" Style="{StaticResource FlatButton}" Padding="6" ToolTip="Más colores…" AutomationProperties.Name="Más colores">
                        <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="14"/>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="OpacityPanel" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Opacidad" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                    <Slider x:Name="OpacitySlider" Width="90" Minimum="10" Maximum="100" Value="100" Margin="8,0,0,0"
                            IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" AutomationProperties.Name="Opacidad"/>
                </StackPanel>
                <StackPanel x:Name="ThicknessPanel" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Grosor" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                    <Slider x:Name="ThicknessSlider" Width="110" AutomationProperties.Name="Grosor" Minimum="1" Maximum="40" Value="4" Margin="8,0,0,0"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Value, ElementName=ThicknessSlider}" Width="22" Margin="6,0,0,0"
                               Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="ShapePanel" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ComboBox x:Name="ShapeCombo" MinWidth="130" SelectedIndex="0">
                        <ComboBoxItem Tag="Rectangle">▭  Rectángulo</ComboBoxItem>
                        <ComboBoxItem Tag="Ellipse">◯  Círculo</ComboBoxItem>
                        <ComboBoxItem Tag="Line">╱  Línea</ComboBoxItem>
                        <ComboBoxItem Tag="Arrow">➚  Flecha</ComboBoxItem>
                    </ComboBox>
                    <CheckBox x:Name="FillCheck" Content="Relleno" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="TextPanel" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ComboBox x:Name="FontSizeCombo" MinWidth="80" SelectedIndex="3">
                        <ComboBoxItem>14</ComboBoxItem>
                        <ComboBoxItem>18</ComboBoxItem>
                        <ComboBoxItem>24</ComboBoxItem>
                        <ComboBoxItem>32</ComboBoxItem>
                        <ComboBoxItem>48</ComboBoxItem>
                        <ComboBoxItem>64</ComboBoxItem>
                        <ComboBoxItem>96</ComboBoxItem>
                    </ComboBox>
                    <ToggleButton x:Name="BoldToggle" Style="{StaticResource SegmentToggle}" Padding="10,6" Margin="8,0,0,0" ToolTip="Negrita">
                        <TextBlock Text="&#xE8DD;" Style="{StaticResource Icon}" FontSize="14"/>
                    </ToggleButton>
                    <RadioButton x:Name="AlignLeft" GroupName="align" Style="{StaticResource SegmentToggle}" Padding="10,6" Margin="8,0,0,0" IsChecked="True" ToolTip="Izquierda">
                        <TextBlock Text="&#xE8E4;" Style="{StaticResource Icon}" FontSize="14"/>
                    </RadioButton>
                    <RadioButton x:Name="AlignCenter" GroupName="align" Style="{StaticResource SegmentToggle}" Padding="10,6" ToolTip="Centro">
                        <TextBlock Text="&#xE8E3;" Style="{StaticResource Icon}" FontSize="14"/>
                    </RadioButton>
                    <RadioButton x:Name="AlignRight" GroupName="align" Style="{StaticResource SegmentToggle}" Padding="10,6" ToolTip="Derecha">
                        <TextBlock Text="&#xE8E2;" Style="{StaticResource Icon}" FontSize="14"/>
                    </RadioButton>
                </StackPanel>
                <StackPanel x:Name="CropPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CropSizeText" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="CropCancel" Content="Cancelar" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/>
                    <Button x:Name="CropApply" Content="Aplicar" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
                <TextBlock x:Name="HintText" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Lienzo -->
        <Border Grid.Row="2" x:Name="Stage" CornerRadius="14" Background="{DynamicResource Stage}" ClipToBounds="True">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16">
                <Grid x:Name="Surface" ClipToBounds="True">
                    <Image x:Name="BaseImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Canvas x:Name="Ink" Background="Transparent" ClipToBounds="True" Cursor="Pen"/>
                    <Canvas x:Name="CropLayer" Background="Transparent" Visibility="Collapsed"/>
                </Grid>
            </Viewbox>
        </Border>
    </Grid>
</UserControl>
