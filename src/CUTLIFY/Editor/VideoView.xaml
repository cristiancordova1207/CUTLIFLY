<UserControl x:Class="Cutlify.Editor.VideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    <TextBlock x:Name="InfoText" Style="{StaticResource Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="CopyButton" Style="{StaticResource FlatButton}" ToolTip="Copiar archivo al portapapeles" MinWidth="64">
                        <StackPanel><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/><TextBlock Text="Copiar archivo" Style="{StaticResource Caption}"/></StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource FlatButton}" ToolTip="Guardar" MinWidth="56">
                        <StackPanel><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}"/><TextBlock Text="Guardar" Style="{StaticResource Caption}"/></StackPanel>
                    </Button>
                    <Button x:Name="SaveAsButton" Style="{StaticResource FlatButton}" ToolTip="Guardar como…" MinWidth="64">
                        <StackPanel><TextBlock Text="&#xE792;" Style="{StaticResource Icon}"/><TextBlock Text="Guardar como" Style="{StaticResource Caption}"/></StackPanel>
                    </Button>
                    <Button x:Name="OpenButton" Style="{StaticResource FlatButton}" ToolTip="Abrir con el reproductor predeterminado" MinWidth="56">
                        <StackPanel><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}"/><TextBlock Text="Abrir" Style="{StaticResource Caption}"/></StackPanel>
                    </Button>
                    <Button x:Name="FolderButton" Style="{StaticResource FlatButton}" ToolTip="Abrir ubicación" MinWidth="56">
                        <StackPanel><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}"/><TextBlock Text="Ubicación" Style="{StaticResource Caption}"/></StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource FlatButton}" ToolTip="Eliminar" MinWidth="56">
                        <StackPanel><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/><TextBlock Text="Eliminar" Style="{StaticResource Caption}"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" CornerRadius="14" Background="#0E0C14" ClipToBounds="True">
            <Grid>
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Margin="8"/>
                <Button x:Name="BigPlay" Style="{StaticResource FlatButton}" Width="72" Height="72" Background="#66FFFFFF"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="28" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Style="{StaticResource FlatButton}" Padding="10,6">
                    <TextBlock x:Name="PlayIcon" Text="&#xE768;" Style="{StaticResource Icon}"/>
                </Button>
                <TextBlock Grid.Column="1" x:Name="PositionText" Text="00:00" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="6,0,10,0"/>
                <Slider Grid.Column="2" x:Name="Seek" VerticalAlignment="Center" Minimum="0" IsMoveToPointEnabled="True"/>
                <TextBlock Grid.Column="3" x:Name="DurationText" Text="00:00" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="10,0,6,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
