<Window x:Class="Cutlifly.Notifications.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CUTLIFLY" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Width="404" SizeToContent="Height" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Border x:Name="Root" Margin="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="14" Effect="{StaticResource SoftShadow}" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" X="40"/>
        </Border.RenderTransform>
        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top">
                <Image Source="pack://application:,,,/Assets/logo.png"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                <TextBlock Text="CUTLIFLY" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                <TextBlock x:Name="TitleText" Margin="0,2,0,0" FontSize="14" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,10,0,0"/>
            </StackPanel>
            <Border Grid.Column="2" x:Name="ThumbBorder" CornerRadius="8" Width="96" Height="60" ClipToBounds="True"
                    VerticalAlignment="Center" Background="{DynamicResource Stage}">
                <Grid>
                    <Image x:Name="Thumb" Stretch="UniformToFill"/>
                    <TextBlock x:Name="Badge" Visibility="Collapsed" Foreground="White" FontSize="11" Margin="0,0,5,3"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8"/></TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>
            <Button Grid.Column="3" x:Name="CloseButton" Style="{StaticResource FlatButton}" Padding="6" Margin="6,-6,-6,0"
                    VerticalAlignment="Top" Foreground="{DynamicResource TextSecondary}">
                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
            </Button>
        </Grid>
    </Border>
</Window>
