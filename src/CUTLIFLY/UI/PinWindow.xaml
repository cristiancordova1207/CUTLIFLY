<Window x:Class="Cutlifly.UI.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CUTLIFLY - Fijada" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" SizeToContent="Manual"
        FontFamily="{StaticResource UiFont}">
    <Border x:Name="Frame" Margin="10" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource Accent}"
            Background="{DynamicResource Surface}" Effect="{StaticResource SoftShadow}" Cursor="SizeAll">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="CopyItem" Header="Copiar" Icon="&#xE8C8;"/>
                <MenuItem x:Name="ZoomInItem" Header="Ampliar" Icon="&#xE8A3;" InputGestureText="Rueda ↑"/>
                <MenuItem x:Name="ZoomOutItem" Header="Reducir" Icon="&#xE71F;" InputGestureText="Rueda ↓"/>
                <MenuItem x:Name="OpacityItem" Header="Semitransparente" Icon="&#xE790;" IsCheckable="True"/>
                <Separator/>
                <MenuItem x:Name="CloseItem" Header="Cerrar" Icon="&#xE711;" InputGestureText="Esc"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Image x:Name="Img" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Button x:Name="CloseButton" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="4" Padding="6" Background="#AA1F1B2E" Foreground="White" Visibility="Collapsed">
                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
            </Button>
        </Grid>
    </Border>
</Window>
