<Window x:Class="Cutlifly.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:Cutlifly.Editor"
        Title="CUTLIFLY" Width="1180" Height="820" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowGradient}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource Text}"
        AllowDrop="True" Icon="pack://application:,,,/Assets/cutlifly.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Grid Margin="16,0,6,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="CUTLIFLY" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="Capture. Record. Share." Style="{StaticResource Secondary}" Margin="10,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0">
                <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimizar"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximizar"/>
                <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Cerrar"/>
            </StackPanel>
        </Grid>

        <!-- Barra de comandos -->
        <DockPanel Grid.Row="1" Margin="16,0,16,12" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="NewButton" Style="{StaticResource PrimaryButton}" Padding="16,9" ToolTip="Nueva captura (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13"/>
                        <TextBlock Text="Nuevo" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="NewMenuButton" Style="{StaticResource PrimaryButton}" Padding="10,9" Margin="3,0,0,0" ToolTip="Más opciones">
                    <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11"/>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="NewMenu">
                            <MenuItem Header="Captura" Icon="&#xE722;">
                                <MenuItem x:Name="NewCapRect" Header="Rectangular" Icon="&#xE8B3;"/>
                                <MenuItem x:Name="NewCapWindow" Header="Ventana" Icon="&#xE7C4;"/>
                                <MenuItem x:Name="NewCapFull" Header="Pantalla completa" Icon="&#xE740;"/>
                                <Separator/>
                                <MenuItem x:Name="NewCap3" Header="En 3 segundos" Icon="&#xE916;"/>
                                <MenuItem x:Name="NewCap5" Header="En 5 segundos" Icon="&#xE916;"/>
                                <MenuItem x:Name="NewCap10" Header="En 10 segundos" Icon="&#xE916;"/>
                            </MenuItem>
                            <MenuItem Header="Grabación" Icon="&#xE714;">
                                <MenuItem x:Name="NewRecRect" Header="Rectangular" Icon="&#xE8B3;"/>
                                <MenuItem x:Name="NewRecWindow" Header="Ventana" Icon="&#xE7C4;"/>
                                <MenuItem x:Name="NewRecFull" Header="Pantalla completa" Icon="&#xE740;"/>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Border Margin="12,0,0,0" Padding="3" CornerRadius="11" Background="{DynamicResource AccentSoft}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="KindCapture" GroupName="kind" Style="{StaticResource SegmentToggle}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" FontSize="14"/>
                                <TextBlock Text="Captura" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="KindRecord" GroupName="kind" Style="{StaticResource SegmentToggle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="14"/>
                                <TextBlock Text="Grabación" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <ComboBox x:Name="ModeCombo" Margin="12,0,0,0" MinWidth="170" ToolTip="Modo de recorte">
                    <ComboBoxItem Tag="Rectangle">⬚  Rectangular</ComboBoxItem>
                    <ComboBoxItem Tag="Window">▣  Ventana</ComboBoxItem>
                    <ComboBoxItem Tag="FullScreen">⛶  Pantalla completa</ComboBoxItem>
                </ComboBox>
                <ComboBox x:Name="DelayCombo" Margin="8,0,0,0" MinWidth="130" ToolTip="Temporizador">
                    <ComboBoxItem Tag="0">⏱  Sin retraso</ComboBoxItem>
                    <ComboBoxItem Tag="3">⏱  3 segundos</ComboBoxItem>
                    <ComboBoxItem Tag="5">⏱  5 segundos</ComboBoxItem>
                    <ComboBoxItem Tag="10">⏱  10 segundos</ComboBoxItem>
                </ComboBox>
                <Button x:Name="RepeatButton" Style="{StaticResource FlatButton}" Margin="8,0,0,0" ToolTip="Repetir la última captura con la misma configuración">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14"/>
                        <TextBlock Text="Capturar otra vez" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="HistoryButton" Style="{StaticResource FlatButton}" ToolTip="Historial">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="15"/>
                        <TextBlock Text="Historial" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsButton" Style="{StaticResource FlatButton}" ToolTip="Configuración" Margin="4,0,0,0">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15"/>
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource FlatButton}" ToolTip="Más" Margin="4,0,0,0">
                    <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="15"/>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreMenu">
                            <MenuItem x:Name="MenuUpdates" Header="Buscar actualizaciones" Icon="&#xE895;"/>
                            <MenuItem x:Name="MenuTemp" Header="Abrir carpeta temporal" Icon="&#xE8B7;"/>
                            <MenuItem x:Name="MenuLogs" Header="Abrir carpeta de logs" Icon="&#xE9F9;"/>
                            <MenuItem x:Name="MenuAbout" Header="Acerca de CUTLIFLY" Icon="&#xE946;"/>
                            <Separator/>
                            <MenuItem x:Name="MenuExit" Header="Salir" Icon="&#xE7E8;"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Contenido -->
        <Grid Grid.Row="2" Margin="16,0,16,12">
            <Border x:Name="EmptyState" Style="{StaticResource Card}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="72" Height="72" Opacity="0.95" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <TextBlock Text="Presiona" FontSize="16" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="8,3" Margin="8,0,0,0">
                            <TextBlock x:Name="CaptureKeyText" Text="Win + Shift + S" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" FontSize="15"/>
                        </Border>
                        <TextBlock Text="para capturar" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="o" Style="{StaticResource Secondary}" FontSize="13" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource PinkSoft}" CornerRadius="6" Padding="8,2" Margin="8,0,0,0">
                            <TextBlock x:Name="RecordKeyText" Text="Win + Shift + R" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/>
                        </Border>
                        <TextBlock Text="para grabar una región" Style="{StaticResource Secondary}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Button x:Name="EmptyCapture" Style="{StaticResource SoftButton}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" FontSize="14"/>
                                <TextBlock Text="Nueva captura" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="EmptyRecord" Style="{StaticResource OutlineButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="14"/>
                                <TextBlock Text="Nueva grabación" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="También puedes arrastrar imágenes o vídeos aquí." Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
            <ed:EditorView x:Name="Editor" Visibility="Collapsed"/>
            <ed:VideoView x:Name="Video" Visibility="Collapsed"/>
            <Border x:Name="DropHint" Visibility="Collapsed" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource Accent}"
                    Background="#337C5CFF" IsHitTestVisible="False">
                <TextBlock Text="Suelta para abrir en CUTLIFLY" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Capturas recientes -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="16,0,16,16" Padding="14,10,14,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Capturas recientes" Style="{StaticResource SectionTitle}"/>
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CountText" Text="0" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <CheckBox x:Name="TempSwitch" Style="{StaticResource Switch}" Content="Guardado temporal" Margin="0" ToolTip="Desactívalo para el modo solo portapapeles"/>
                        <ComboBox x:Name="RetentionCombo" Margin="12,0,0,0" MinWidth="120" ToolTip="Eliminar temporales después de">
                            <ComboBoxItem Tag="5">5 minutos</ComboBoxItem>
                            <ComboBoxItem Tag="30">30 minutos</ComboBoxItem>
                            <ComboBoxItem Tag="60">1 hora</ComboBoxItem>
                            <ComboBoxItem Tag="360">6 horas</ComboBoxItem>
                            <ComboBoxItem Tag="720">12 horas</ComboBoxItem>
                            <ComboBoxItem Tag="1440">1 día</ComboBoxItem>
                            <ComboBoxItem Tag="4320">3 días</ComboBoxItem>
                            <ComboBoxItem Tag="0">Nunca</ComboBoxItem>
                        </ComboBox>
                        <Button x:Name="OpenTempButton" Style="{StaticResource SoftButton}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13"/>
                                <TextBlock Text="Abrir carpeta" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SeeAllButton" Style="{StaticResource FlatButton}" Content="Ver todo" Margin="6,0,0,0" Foreground="{DynamicResource Accent}"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Grid.Row="1" x:Name="RecentEmpty" Text="Tus capturas y grabaciones aparecerán aquí." Style="{StaticResource Secondary}" Margin="2,10,0,14"/>
                <ListBox Grid.Row="1" x:Name="RecentList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CardItem}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.Orientation="Horizontal" Height="128">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="146" Background="Transparent">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copiar" Icon="&#xE8C8;" Click="Ctx_Copy"/>
                                        <MenuItem Header="Guardar" Icon="&#xE74E;" Click="Ctx_Save"/>
                                        <MenuItem Header="Abrir" Icon="&#xE8A7;" Click="Ctx_Open"/>
                                        <MenuItem Header="Fijar" Icon="&#xE718;" Click="Ctx_Pin"/>
                                        <MenuItem Header="Abrir ubicación" Icon="&#xE8B7;" Click="Ctx_Location"/>
                                        <Separator/>
                                        <MenuItem Header="Eliminar" Icon="&#xE74D;" Click="Ctx_Delete"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Border Height="82" CornerRadius="8" Background="{DynamicResource Stage}">
                                    <Grid>
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <Border Background="#B31F1B2E" CornerRadius="5" Padding="5,1" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVideo}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DurationLabel}" Foreground="White" FontSize="11" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DockPanel Margin="2,6,2,0">
                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xEB9F;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                        <Setter Property="Text" Value="&#xE714;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RelativeTime}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
